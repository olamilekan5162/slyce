# Enoki API Key (from https://enoki.mystenlabs.com)
VITE_ENOKI_API_KEY=your_enoki_api_key_here

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Facebook OAuth Client ID
VITE_FACEBOOK_CLIENT_ID=your_facebook_client_id_here

# Twitch OAuth Client ID
VITE_TWITCH_CLIENT_ID=your_twitch_client_id_here